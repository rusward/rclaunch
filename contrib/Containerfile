# Сборочное окружение для rclaunch (Linux).
#
# Использование:
#   podman build -t rclaunch-build -f contrib/Containerfile .
#   podman run --rm --security-opt label=disable \
#     -v "$PWD:/app" -v rclaunch-node-modules:/app/node_modules \
#     -w /app -e CI=true \
#     rclaunch-build bash -lc 'pnpm install --frozen-lockfile && pnpm tauri build --no-bundle'
#
# Образ содержит Rust stable, Node.js 22, pnpm 10 и системные
# зависимости Tauri 2 для Linux (webkit2gtk-4.1, GTK3 и т.д.).

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    file \
    git \
    libayatana-appindicator3-dev \
    libdbus-1-dev \
    libgtk-3-dev \
    librsvg2-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    patchelf \
    pkg-config \
    wget \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/node/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain stable --no-modify-path \
    && rm /tmp/rustup.sh

RUN mkdir -p /usr/local/node \
    && curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.xz \
       | tar -xJ -C /usr/local/node --strip-components=1 \
    && npm install -g pnpm@10 --silent

WORKDIR /app

CMD ["bash"]
